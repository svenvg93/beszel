FROM --platform=$BUILDPLATFORM golang:bookworm AS builder

WORKDIR /app

COPY ../go.mod ../go.sum ./
RUN --mount=type=cache,target=/root/go/pkg/mod go mod download

# Copy source files
COPY . ./

# Build
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOGC=75 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -tags glibc -ldflags "-w -s" -o /agent ./internal/cmd/agent

# Fetch smartctl binary
FROM debian:bookworm-slim AS smartmontools
RUN apt-get update \
    && apt-get install -y --no-install-recommends smartmontools \
    && rm -rf /var/lib/apt/lists/*

# --------------------------
# Final image: distroless (glibc, no shell, small footprint)
# NVIDIA: use runtime: nvidia — NVML library is injected automatically
# Intel GPU: mount intel_gpu_top from the host:
#   volumes: ["/usr/bin/intel_gpu_top:/usr/bin/intel_gpu_top:ro"]
# --------------------------
FROM gcr.io/distroless/base-debian12

COPY --from=builder /agent /agent
COPY --from=smartmontools /usr/sbin/smartctl /usr/sbin/smartctl

# AMD GPU name lookup (used by agent on Linux when /usr/share/libdrm/amdgpu.ids is read)
COPY --from=builder /app/agent/test-data/amdgpu.ids /usr/share/libdrm/amdgpu.ids

# Ensure data persistence across container recreations
VOLUME ["/var/lib/beszel-agent"]

ENTRYPOINT ["/agent"]
